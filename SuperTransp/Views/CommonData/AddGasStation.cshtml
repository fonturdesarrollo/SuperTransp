@model SuperTransp.Models.GastStationViewModel
@using SuperTransp.Models
@{
	Layout = "";
}
<!DOCTYPE HTML>
<html>
<head>
	<title>Agregar / Editar Estación de Servicio</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
	<link rel="stylesheet" href="~/assets/css/main.css" />
	<noscript><link rel="stylesheet" href="~/assets/css/noscript.css" /></noscript>
	<link rel="stylesheet" href="~/datatable/css/bootstrap.css" />
	<link rel="stylesheet" href="~/datatable/css/dataTables.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/datatable/css/responsive.bootstrap4.min.css" />
	<link rel="icon" type="image/x-icon" href="~/images/Logo.ico" />

	<style>
		.is-invalid {
			border: 2px solid red;
			background-color: #ffe6e6;
		}

		.station-link {
			cursor: pointer;
			color: #4cbece;
			text-decoration: underline;
		}

		.station-link:hover {
			color: #2aa8c0;
		}
	</style>
</head>
<body class="is-preload">
	@using (Html.BeginForm("AddGasStation", "CommonData", FormMethod.Post))
	{
		@Html.AntiForgeryToken()
		@Html.HiddenFor(m => m.GasStationId)

		<!-- Wrapper -->
		<div id="wrapper">

			<!-- Header -->
			<header id="header">
				<div class="inner">

					<!-- Logo -->
					<a href="#" class="logo">
						<span><img src="~/images/Logo.png" width="100px" height="100px" alt="" /></span>
						<br />
						<span class="title">@ViewBag.EmployeeName</span>
						<br />
						@if (TempData["SuccessMessage"] != null)
						{
							<div id="successMessage" class="alert alert-success">
								@TempData["SuccessMessage"]
							</div>
						}
					</a>
				</div>
				<!-- Nav -->
				<nav>
					<ul>
						<li><a href="#menu">Menu</a></li>
					</ul>
				</nav>
			</header>

			<!-- Menu -->
			<nav id="menu">
				<h2>Menu</h2>
				<ul>
					<li>@Html.ActionLink("Inicio", "Index", "Home")</li>
					<li>@Html.ActionLink("Ajustes", "Index", "Settings")</li>
					<li>@Html.ActionLink("Salir", "Login", "Security")</li>
				</ul>
			</nav>

			<!-- Main -->
			<div id="main">
				<div class="inner">

					<!-- Form -->
					<section>
						<h1 style="color:#4cbece">Agregar / Editar Estación de Servicio</h1>
						<br />
						<div class="row gtr-uniform">
							<div class="col-6">
								<strong>Estado:</strong>
								<select id="StateIdFilter" class="form-control">
									<option value="">-- Seleccione el estado --</option>
									@foreach (var state in (IEnumerable<GeographyViewModel>)ViewBag.States)
									{
										<option value="@state.StateId">@state.StateName</option>
									}
								</select>
							</div>
							<div class="col-6">
								<strong>Municipio:</strong>
								@Html.DropDownListFor(m => m.MunicipalityId, new SelectList(Enumerable.Empty<SelectListItem>()), "-- Seleccione el municipio --", new { @class = "form-control" })
							</div>
							<div class="col-12">
								<strong>Nombre:</strong>
								@Html.TextBoxFor(x => x.GasStationName, new { placeholder = "Nombre de la estación de servicio", tabindex = "0", maxlength = "150" })
							</div>
							<div class="col-12">
								<strong>Dirección:</strong>
								@Html.TextBoxFor(x => x.GasStationAddress, new { placeholder = "Dirección de la estación de servicio", tabindex = "0", maxlength = "150" })
							</div>
							<div class="col-12">
								<ul class="actions">
									<li><input type="button" value="Nuevo" id="clearForm" /></li>
									<li><input type="submit" value="Guardar" class="primary" id="saveRequest" /></li>
								</ul>
							</div>
						</div>
					</section>

					<br />

					<!-- DataTable -->
					<section>
						<h2 style="color:#4cbece">Estaciones Registradas</h2>
						<table id="gasStationsTable" class="table table-striped table-bordered" style="width:100%">
							<thead>
								<tr>
									<th>Estado</th>
									<th>Municipio</th>
									<th>Nombre</th>
									<th>Dirección</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var station in (IEnumerable<GastStationViewModel>)ViewBag.GasStations)
								{
									<tr>
										<td>@station.StateName</td>
										<td>@station.MunicipalityName</td>
										<td class="station-link"
											data-id="@station.GasStationId"
											data-state="@station.StateId"
											data-municipality="@station.MunicipalityId"
											data-name="@station.GasStationName"
											data-address="@station.GasStationAddress">
											@station.GasStationName
										</td>
										<td>@station.GasStationAddress</td>
									</tr>
								}
							</tbody>
						</table>
					</section>

				</div>
			</div>
		</div>
	}

	<!-- Scripts -->
	<script src="~/datatable/js/jquery-3.5.1.js"></script>
	<script src="~/datatable/js/jquery.dataTables.min.js"></script>
	<script src="~/datatable/js/dataTables.bootstrap4.js"></script>
	<script src="~/datatable/js/dataTables.responsive.min.js"></script>
	<script src="~/datatable/js/responsive.bootstrap4.min.js"></script>
	<script src="~/assets/js/browser.min.js"></script>
	<script src="~/assets/js/breakpoints.min.js"></script>
	<script src="~/assets/js/util.js"></script>
	<script src="~/assets/js/main.js"></script>
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script type="text/javascript">

		function loadMunicipalities(stateId, selectedMunicipalityId) {
			var $muni = $('#MunicipalityId');
			$muni.empty().append('<option value="">-- Seleccione el municipio --</option>');
			if (!stateId) return;

			$.getJSON('@Url.Action("GetMunicipalitiesByStateId", "CommonData")', { stateId: stateId }, function (data) {
				$.each(data, function (i, m) {
					$muni.append('<option value="' + m.municipalityId + '">' + m.municipalityName + '</option>');
				});
				if (selectedMunicipalityId) {
					$muni.val(selectedMunicipalityId);
				}
			});
		}

		function sanitizeText(value) {
			return value
				.replace(/[ñÑ]/g, '\x00')
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toUpperCase()
				.replace(/\x00/g, 'Ñ');
		}

		function applyTextBehavior(selector) {
			$(selector).on('input', function () {
				var pos = this.selectionStart;
				var sanitized = sanitizeText($(this).val());
				$(this).val(sanitized);
				this.setSelectionRange(pos, pos);
			});

			$(selector).on('paste', function (e) {
				e.preventDefault();
				var pasted = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
				var sanitized = sanitizeText(pasted);
				var pos = this.selectionStart;
				var current = $(this).val();
				var newVal = current.slice(0, pos) + sanitized + current.slice(this.selectionEnd);
				$(this).val(newVal);
				var newPos = pos + sanitized.length;
				this.setSelectionRange(newPos, newPos);
			});
		}

		$(document).ready(function () {

			applyTextBehavior('#GasStationName');
			applyTextBehavior('#GasStationAddress');

			$('#gasStationsTable').DataTable({
				stateSave: true,
				responsive: true,
				"language": {
					"sProcessing": "Procesando...",
					"sLengthMenu": "Mostrar _MENU_ registros",
					"sZeroRecords": "No se encontraron resultados",
					"sEmptyTable": "Ningún dato disponible en esta tabla",
					"sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
					"sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
					"sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
					"sSearch": "Buscar:",
					"oPaginate": {
						"sFirst": "Primero",
						"sLast": "Último",
						"sNext": "Siguiente",
						"sPrevious": "Anterior"
					}
				}
			});

			$('#StateIdFilter').on('change', function () {
				loadMunicipalities(parseInt($(this).val()) || 0, 0);
			});

			$('#gasStationsTable').on('click', '.station-link', function () {
				var stateId = parseInt($(this).data('state'));
				var municipalityId = parseInt($(this).data('municipality'));
				var name = $(this).data('name');
				var address = $(this).data('address');
				var id = parseInt($(this).data('id'));

				$('#GasStationId').val(id);
				$('#GasStationName').val(name);
				$('#GasStationAddress').val(address);

				$('#StateIdFilter').val(stateId);
				loadMunicipalities(stateId, municipalityId);

				$('html, body').animate({ scrollTop: 0 }, 'fast');
			});

			$('#clearForm').on('click', function () {
				$('#GasStationId').val(0);
				$('#StateIdFilter').val('');
				$('#MunicipalityId').empty().append('<option value="">-- Seleccione el municipio --</option>');
				$('#GasStationName').val('');
				$('#GasStationAddress').val('');
				$('#GasStationName').removeClass('is-invalid');
				$('#GasStationAddress').removeClass('is-invalid');
				$('#MunicipalityId').removeClass('is-invalid');
			});

			$('#saveRequest').on('click', function (event) {
				event.preventDefault();

				if (!isOkToSave()) {
					return false;
				}

				if (!confirm('¿Está seguro de que desea guardar los datos?')) {
					return false;
				}

				$(this).closest('form').trigger('submit');
			});

			setTimeout(function () {
				$('#successMessage').fadeOut('slow');
			}, 2500);
		});

		function isOkToSave() {
			var firstInvalidField = null;
			var message = '';

			if ($('#MunicipalityId').val() === '' && !firstInvalidField) {
				firstInvalidField = '#MunicipalityId';
				message = 'Debe seleccionar el municipio';
			}

			if ($('#GasStationName').val().trim() === '' && !firstInvalidField) {
				firstInvalidField = '#GasStationName';
				message = 'Debe ingresar el nombre de la estación de servicio';
			}

			if ($('#GasStationAddress').val().trim() === '' && !firstInvalidField) {
				firstInvalidField = '#GasStationAddress';
				message = 'Debe ingresar la dirección de la estación de servicio';
			}

			if (firstInvalidField) {
				showAlert(message, firstInvalidField);
				return false;
			}

			return true;
		}

		function showAlert(message, selector) {
			alert(message);
			highlightErrorField(selector);
			$(selector).focus();
		}

		function highlightErrorField(selector) {
			$(selector).addClass('is-invalid');
			$(selector).on('input change', function () {
				$(this).removeClass('is-invalid');
			});
			$(selector)[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
	</script>
</body>
</html>
