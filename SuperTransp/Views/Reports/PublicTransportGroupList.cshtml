@* @model List<SuperTransp.Models.PublicTransportGroupViewModel> *@
@inject SuperTransp.Core.Interfaces.IPublicTransportGroup PublicTransportGroupService
@{
	Layout = "";
}
<!DOCTYPE HTML>
<html>

<head>
	<title>Reportes - Consultar Organizaciones y Asociados<</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
	<link rel="stylesheet" href="~/assets/css/main.css" />
	<noscript><link rel="stylesheet" href="~/assets/css/noscript.css" /></noscript>
	<link rel="icon" type="image/x-icon" href="~/images/Logo.ico" />

	@*DataTable************************************************************************@
	<link rel="stylesheet" href="~/datatable/css/bootstrap.css" />
	<link rel="stylesheet" href="~/datatable/css/dataTables.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/datatable/css/responsive.bootstrap4.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
	@*************************************************************************************@
	<style>
		.logo-container {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

			.logo-container img {
				display: block;
			}

		.btn-view-route {
			background: none;
			border: none;
			box-shadow: none;
			padding: 0 8px;
			height: auto;
			line-height: 1;
			cursor: pointer;
			color: #4cbece;
		}

			.btn-view-route:hover {
				color: #667eea;
			}

		.no-route-icon {
			color: #b0b5bd;
			cursor: default;
		}
	</style>

</head>
<body class="is-preload">
	<div style="width:100%; max-width: 100em; margin: 0 auto; padding: 0 1em;">
		<!-- Header -->
		<header id="header">
			<div class="inner">
				<!-- Logo -->
				<div class="logo-container">
					<!-- Logo izquierdo -->
					<img src="~/images/Logo.png" width="100px" height="100px" alt="Logo principal" />

					<!-- Logo derecho -->
					<img src="~/images/super-transp-logo.png" width="150px" height="150px" alt="Logo SuperTransp" />
				</div>
				<div class="logo">
					<span>@ViewBag.EmployeeName</span>
					<br />
					<span>Reportes - Consultar organizaciones y asociados</span>
				</div>
			</div>
			<!-- Nav -->
			<nav>
				<ul>
					<li><a href="#menu">Menu</a></li>
				</ul>
			</nav>
		</header>

		<!-- Menu -->
		<nav id="menu">
			<h2>Menu</h2>
			<ul>
				<li>@Html.ActionLink("Inicio", "Index", "Home")</li>
				<li>@Html.ActionLink("Organizaciones con asociados supervisados", "PublicTransportGroupSupervisedDriversStatistics", "Reports")</li>
				<li>@Html.ActionLink("Estadísticas Organizaciones por estado", "DashboardPTG", "Reports")</li>
				<li>@Html.ActionLink("Estadísticas de Supervisión", "Dashboard", "Reports")</li>
				<li>@Html.ActionLink("Reportes/Consultas", "Index", "Reports")</li>
				<li>@Html.ActionLink("Salir", "Login", "Security")</li>
			</ul>
		</nav>

		<div id="main">
			<div class="inner">
				<!-- Form -->
				<section>
					<h4 style="color:#4cbece">Organizaciones Registradas</h4>
					<br />
					<div id="loadingSpinner" style="text-align:center; padding:1em;">
						<div class="spinner-border text-info" role="status">
							<span class="sr-only">Cargando...</span>
						</div>
					</div>
					<table id="publicTransportGroupListDetail" class="table table-striped table-bordered dt-responsive dt-nowrap">
						<thead>
							<tr>
								<th>Nombre</th>
								<th>Estado</th>
								<th>Modalidad</th>
								<th>Rif</th>
								<th>Flota</th>
								<th>Cargados</th>
								<th>Supervisados</th>
								<th>Estatus</th>
								<th>Mapa de ruta</th>
							</tr>
						</thead>
					</table>
				</section>
			</div>
		</div>
	</div>

	<div id="routeListModal" class="route-modal" style="z-index: 19000;" role="dialog" aria-modal="true" aria-labelledby="routeListModalTitle">
		<div class="route-modal-content" style="max-width: 760px;">
			<div class="route-modal-header">
				<h3 id="routeListModalTitle">Rutas de la organización</h3>
				<button type="button" id="btnCloseRouteListModal" aria-label="Cerrar" style="padding:0 12px; height:36px; line-height:36px; font-size:1.6em; cursor:pointer; background:none; border:none; box-shadow:none; color:#666;">&times;</button>
			</div>
			<table style="width:100%; border-collapse:collapse; background:#fff; border:1px solid #ddd;">
				<thead>
					<tr style="background:#f2f4f8;">
						<th style="padding:8px 12px; text-align:left; border-bottom:1px solid #ddd; font-weight:600;">Inicio de la ruta</th>
						<th style="padding:8px 12px; text-align:left; border-bottom:1px solid #ddd; font-weight:600;">Última parada</th>
						<th style="width:120px; padding:8px 12px; text-align:center; border-bottom:1px solid #ddd; font-weight:600;">Ver en mapa</th>
					</tr>
				</thead>
				<tbody id="routeListTableBody">
				</tbody>
			</table>
		</div>
	</div>

	@await Html.PartialAsync("~/Views/PublicTransportGroup/_RouteModal.cshtml")

	<!-- Scripts -->
	<script src="~/assets/js/jquery.min.js"></script>
	<script src="~/assets/js/browser.min.js"></script>
	<script src="~/assets/js/breakpoints.min.js"></script>
	<script src="~/assets/js/util.js"></script>
	<script src="~/assets/js/main.js"></script>

	@*DataTable*******************************************@
	<script src="~/datatable/js/jquery-3.5.1.js"></script>
	<script src="~/datatable/js/jquery.dataTables.min.js"></script>
	<script src="~/datatable/js/dataTables.bootstrap4.js"></script>
	<script src="~/datatable/js/dataTables.responsive.min.js"></script>
	<script src="~/datatable/js/responsive.bootstrap4.min.js"></script>
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	@***********************************************************@

	<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
	<script src="~/js/route-map-viewer.js" asp-append-version="true"></script>

	<script type="text/javascript">

		$(document).ready(function () {
			var checkExistingUrl = '@Url.Action("GetPublicTransportGroup", "Reports")';
			var urlPtg = '@Url.Action("PublicTransportGroupDriverList", "Reports")';
			var routeUrl = '@Url.Action("GetPublicTransportGroupRoute", "Reports")';

			var mapIcon = '<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">' +
				'<path fill-rule="evenodd" d="M15.817.113A.5.5 0 0 1 16 .5v14a.5.5 0 0 1-.402.49l-5 1a.502.502 0 0 1-.196 0L5.5 15.01l-4.902.98A.5.5 0 0 1 0 15.5v-14a.5.5 0 0 1 .402-.49l5-1a.5.5 0 0 1 .196 0L10.5.99l4.902-.98a.5.5 0 0 1 .415.103zM10 1.91l-4-.8v12.98l4 .8V1.91zm1 12.98 4-.8V1.11l-4 .8v12.98zm-6-.8V1.11l-4 .8v12.98l4-.8z"/>' +
				'</svg>';

			// Same map with a slash: the organization has no route loaded
			var noMapIcon = '<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">' +
				'<path fill-rule="evenodd" d="M15.817.113A.5.5 0 0 1 16 .5v14a.5.5 0 0 1-.402.49l-5 1a.502.502 0 0 1-.196 0L5.5 15.01l-4.902.98A.5.5 0 0 1 0 15.5v-14a.5.5 0 0 1 .402-.49l5-1a.5.5 0 0 1 .196 0L10.5.99l4.902-.98a.5.5 0 0 1 .415.103zM10 1.91l-4-.8v12.98l4 .8V1.91zm1 12.98 4-.8V1.11l-4 .8v12.98zm-6-.8V1.11l-4 .8v12.98l4-.8z"/>' +
				'<line x1="1" y1="15" x2="15" y2="1" stroke="#c0392b" stroke-width="1.8" stroke-linecap="round"/>' +
				'</svg>';
			
			$('#loadingSpinner').show();

			$('#publicTransportGroupListDetail').DataTable({
				ajax: {
					url: checkExistingUrl,
					dataSrc: function (json) {
						$('#loadingSpinner').fadeOut();
						return json.data;
					}
				},
				pageLength: 10,
				lengthMenu: [10, 25, 50, 100, 500, 1000, 2000, 3000],
				columns: [
					{
						data: 'nombre',
						render: function (data, type, row) {
						return `<a href="${urlPtg}?publicTransportGroupId=${row.id}"
								   style="color:${row.color};"
								   target="_blank">${data}</a>`;
						}
					},
					{ data: 'estado' },
					{ data: 'modalidad' },
					{ data: 'rif' },
					{ data: 'cupos' },
					{ data: 'cargados' },
					{ data: 'supervisados' },
					{ data: 'estatus' },
					{
						data: 'tieneRuta',
						// The route column stays hidden until AppSettings:EnablePublicTransportGroupRoutes is true
						visible: @(PublicTransportGroupService.RoutesEnabled ? "true" : "false"),
						orderable: false,
						searchable: false,
						className: 'text-center',
						render: function (data, type, row) {
							if (type !== 'display') {
								return data;
							}

							// Taxi and moto taxi units are not assigned a route: show N/A
							if (!row.aplicaRuta) {
								return 'N/A';
							}

							if (data) {
								return '<button type="button" class="btn-view-route" data-id="' + row.id + '" title="Ver mapa de ruta" aria-label="Ver mapa de ruta">' + mapIcon + '</button>';
							}

							return '<span class="btn-view-route no-route-icon" title="Sin ruta cargada" aria-label="Sin ruta cargada">' + noMapIcon + '</span>';
						}
					}
				],
				stateSave: true,
				language: {
					sProcessing: "Procesando...",
					sLengthMenu: "Mostrar _MENU_ registros",
					sZeroRecords: "No se encontraron resultados",
					sEmptyTable: "Ningún dato disponible en esta tabla",
					sInfo: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
					sInfoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
					sInfoFiltered: "(filtrado de un total de _MAX_ registros)",
					sSearch: "Buscar:",
					oPaginate: {
						sFirst: "Primero",
						sLast: "Último",
						sNext: "Siguiente",
						sPrevious: "Anterior"
					}
				}
			});

			var currentRoutes = [];

			function closeRouteListModal() {
				$('#routeListModal').hide();
			}

			// First modal: list of routes of the organization (same table as the form, without the delete column)
			$('#publicTransportGroupListDetail').on('click', 'button.btn-view-route', function () {
				$.getJSON(routeUrl, { publicTransportGroupId: $(this).data('id') })
					.done(function (data) {
						currentRoutes = data.routes;

						var $body = $('#routeListTableBody').empty();

						currentRoutes.forEach(function (route, index) {
							var $row = $('<tr>').attr('data-index', index);

							$('<td style="padding:8px 12px; border-bottom:1px solid #eee;">').text(route.startName).appendTo($row);
							$('<td style="padding:8px 12px; border-bottom:1px solid #eee;">').text(route.endName).appendTo($row);
							$('<td style="padding:8px; text-align:center; border-bottom:1px solid #eee;">').append(
								$('<button type="button" class="btn-view-route-map" title="Ver en mapa" aria-label="Ver en mapa" style="background:none; border:none; box-shadow:none; cursor:pointer; color:#667eea; padding:2px 6px; height:auto; line-height:1;">').html(mapIcon)
							).appendTo($row);

							$body.append($row);
						});

						$('#routeListModalTitle').text(data.title || 'Rutas de la organización');
						$('#routeListModal').css('display', 'flex');
					})
					.fail(function (xhr) {
						alert(xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'No se pudo cargar la ruta.');
					});
			});

			// Second modal: map of the selected route
			$('#routeListTableBody').on('click', '.btn-view-route-map', function () {
				var index = $(this).closest('tr').data('index');

				RouteMapViewer.show($.extend({ title: 'Ruta ' + (index + 1) }, currentRoutes[index]));
			});

			$('#btnCloseRouteListModal').on('click', closeRouteListModal);

			$('#routeListModal').on('mousedown', function (event) {
				if (event.target === this) {
					closeRouteListModal();
				}
			});

			$(document).on('keydown', function (event) {
				if (event.key === 'Escape' && $('#routeListModal').is(':visible')) {
					closeRouteListModal();
				}
			});
		});
	</script>
</body>
</html>