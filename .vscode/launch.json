{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SuperTransp (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SuperTransp/bin/Debug/net8.0/SuperTransp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SuperTransp",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5073"
      },
      "osx": {
        "program": "${workspaceFolder}/SuperTransp/bin/Debug/net8.0/SuperTransp",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5073",
          "DOTNET_ROOT": "${userHome}/.dotnet",
          "PATH": "${userHome}/.dotnet:${env:PATH}"
        }
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/SuperTransp/Views"
      }
    },
    {
      "name": "Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
